rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Configuración de Control de Acceso y Grupos (Permisos del Sistema)
    // Lectura: permitida para cualquier usuario autenticado (o invitados) para conocer los permisos de su grupo.
    // Escritura: EXCLUSIVA para el Administrador del sistema (dbaezh78@gmail.com).
    match /access_control/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'dbaezh78@gmail.com';
    }

    // 2. Registro de Usuarios para Control de Acceso
    // Lectura: permitida para usuarios autenticados.
    // Creación/Edición propia: el usuario autenticado solo puede actualizar su propio nombre, foto y último login,
    // pero NO puede auto-asignarse grupo de administrador ni desbanearse.
    // Edición de grupo, baneo y eliminación: EXCLUSIVA para el Administrador (dbaezh78@gmail.com).
    match /registered_users/{userDoc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.email == 'dbaezh78@gmail.com' ||
        (
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.group == resource.data.group &&
          request.resource.data.banned == resource.data.banned
        )
      );
      allow delete: if request.auth != null && request.auth.token.email == 'dbaezh78@gmail.com';
    }

    // 3. Configuración de Ajustes y Personalización (Ajustes de Columnas, etc.)
    match /configuraciones/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Datos Litúrgicos y Santos
    match /santos/{santoDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /liturgia/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Historial de Actualizaciones (ver.html)
    match /actualizaciones/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Bloqueo por defecto para cualquier otra colección
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'dbaezh78@gmail.com';
    }
  }
}
