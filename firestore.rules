rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para saber si el usuario autenticado es el Administrador principal
    function esAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'dbaezh78@gmail.com';
    }

    // 1. Catálogo y asignaciones anuales de santos
    match /catalogo/{document=**} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // 2. Santos individuales (colección 'santos')
    match /santos/{santoId} {
      allow read: if true;
      allow write: if esAdmin() || request.auth != null;
    }

    // 3. Control de acceso y configuración de grupos ('access_control')
    match /access_control/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Usuarios registrados ('registered_users')
    // Permite que el Administrador gestione a todos, y que cada usuario autenticado
    // pueda registrar y actualizar su propio registro (su perfil o documento de email)
    match /registered_users/{userDocId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if esAdmin();
    }

    // 5. Registro de Direcciones IP Públicas de Acceso ('user_ips')
    // Permite que cualquier usuario autenticado guarde su registro de IP
    match /user_ips/{ipDocId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if esAdmin();
    }

    // 6. Ajustes y preferencias ('ajustes' y 'configuraciones')
    // El admin puede escribir ajustes globales; cada usuario autenticado puede guardar sus propios ajustes
    match /ajustes/{documentId} {
      allow read: if true;
      allow write: if request.auth != null && (
        esAdmin() || 
        request.auth.uid == documentId
      );
    }

    match /configuraciones/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Historial de Actualizaciones ('actualizaciones') y Liturgia
    match /actualizaciones/{document=**} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /liturgia/{document=**} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // 8. Chat de Asistencia y Soporte Fraternal ('support_chats')
    // Permite a usuarios autenticados (hermanos y admin) enviar y leer mensajes en vivo
    match /support_chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 9. Regla por defecto para cualquier otra colección (lectura pública, escritura solo admin)
    match /{document=**} {
      allow read: if true;
      allow write: if esAdmin();
    }

  }
}
